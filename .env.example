# Application
ENVIRONMENT=development
APP_NAME="Job Application Copilot"
SECRET_KEY=change-me-to-a-random-32-byte-secret
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot_dev_password
POSTGRES_DB=job_copilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://copilot:copilot_dev_password@localhost:5432/job_copilot

# ChromaDB (optional local vector store)
CHROMA_PERSIST_DIR=./data/chroma

# Groq LLM
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gmail OAuth2 (read + draft only; never auto-send)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback
FRONTEND_URL=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000
